{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LemonNote",
  "version": "0.0.5",
  "identifier": "io.github.lemdepron.lemonnote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LemonNote",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyRjJFRDcyQzJGODU0MjYKUldRbVZQakNjdTN5b29WSmN6anZqdHJHb2E0dEduc0h4aldrUFFDRmRTSHJtcGN0SGJQaXBmRCsK",
      "endpoints": [
        "https://github.com/lemdepron/LemonNote/releases/latest/download/{{target}}/{{current_version}}"
      ]
    },
    "fs": {
      "scope": {
        "allowed": [
          "$APPDATA/*",
          "$HOME/*",
          "$DESKTOP/*",
          "$DOCUMENT/*",
          "$DOWNLOAD/*"
        ]
      }
    },
    "dialog": {
      "scope": {
        "allowed": [
          "$APPDATA/*",
          "$HOME/*",
          "$DESKTOP/*",
          "$DOCUMENT/*",
          "$DOWNLOAD/*"
        ]
      }
    }
  }
}
